{
  "name": "embed-anywhere",
  "version": "0.1.0",
  "description": "A runbook and tools that let any AI agent build a page, host it, embed it into Kajabi, GoHighLevel, Squarespace or any site builder, and verify the published result.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "snippet": "node bin/embed-snippet.mjs",
    "check": "node bin/check-embed.mjs",
    "verify": "node bin/verify-embed.mjs",
    "test": "node --test tests/*.test.mjs",
    "selftest": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "homepage": "https://github.com/Gatori-ai/embed-anywhere",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gatori-ai/embed-anywhere.git"
  }
}
